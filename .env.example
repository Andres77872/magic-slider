# Local frontend agent API endpoint and model are required.
# Local development uses a browser-reachable localhost URL; 0.0.0.0 is a bind
# address and is not valid as a browser destination.
VITE_API_URL=http://localhost:7000/v1/chat/completions
VITE_AGENT_MODEL=agt-your-presentation-agent-id

# Configure a real browser-client credential if your API requires authentication,
# including local deployments. Leave unset only when the API permits anonymous use.
# All VITE_* values are exposed in the browser bundle; never put provider secrets
# or privileged server credentials here.
# Do not use placeholder values such as NONE, Bearer NONE, or test tokens here.
# VITE_AGENT_API_KEY=

# Optional positive integer limits in milliseconds/bytes.
# Defaults allow server-side image generation before slide actions arrive.
# VITE_AGENT_REQUEST_TIMEOUT_MS=300000
# VITE_AGENT_IDLE_TIMEOUT_MS=120000
# VITE_AGENT_MAX_STREAM_BYTES=1000000
